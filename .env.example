# Mastercuts frontend environment template.
# Copy to `.env.local` for local dev (gitignored) or set in your hosting
# provider for stage / prod.
#
# All variables must be prefixed VITE_ so Vite exposes them to the bundle.

# Base URL of the Mastercuts API (no trailing slash).
#   Local dev (Express shim):     http://localhost:3000
#   Stage:                        https://<stage-api-gateway>.execute-api.ap-south-1.amazonaws.com
#   Prod:                         https://api.mastercuts.example.com
VITE_API_BASE_URL=http://localhost:3000

# Partner (tenant) id this deployment books for. Sent as `X-Partner-Id` on every
# API request; the salon lambdas scope the catalog, availability and bookings to
# it. Must match the environment VITE_API_BASE_URL points at — a prod API URL
# with a dev partner id (or vice versa) resolves to the wrong tenant.
# Optional: when unset the header is omitted and the backend uses its own
# default partner, which is the pre-multi-tenant behaviour.
VITE_PARTNER_ID=

# Auth UI settings. Must match backend OTP behavior.
VITE_OTP_LENGTH=4
VITE_OTP_RESEND_COOLDOWN_SEC=30

# Studio contact phone in E.164 format. Display / tel / WhatsApp formats are
# derived from this single value (see src/lib/contact.ts).
VITE_STUDIO_PHONE=+971564667165

# Studio contact email (used for the footer mailto link and display).
VITE_STUDIO_EMAIL=ask@mastercuts.ae

# Cloudflare public URL for static assets (like video or heavy media)
VITE_CLOUDFLARE_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
