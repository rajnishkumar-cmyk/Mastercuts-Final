# Mastercuts frontend environment template.
# Copy to `.env.local` for local dev (gitignored) or set in your hosting
# provider for stage / prod.
#
# All variables must be prefixed VITE_ so Vite exposes them to the bundle.

# Base URL of the Mastercuts API (no trailing slash).
#   Local dev (Express shim):     http://localhost:3000
#   Stage:                        https://<stage-api-gateway>.execute-api.ap-south-1.amazonaws.com
#   Prod:                         https://api.mastercuts.example.com
VITE_API_BASE_URL=http://localhost:3000

# Auth UI settings. Must match backend OTP behavior.
VITE_OTP_LENGTH=4
VITE_OTP_RESEND_COOLDOWN_SEC=30
